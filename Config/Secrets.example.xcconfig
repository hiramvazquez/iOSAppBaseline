// PLANTILLA de secretos — este archivo SÍ se commitea; `Secrets.xcconfig` NO.
//
// Cómo usarlo:
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
//   (y pon tu clave real en la copia — está en .gitignore)
//
// La clave de TMDB se saca en https://www.themoviedb.org/settings/api
//
// Ojo con las `//` en un xcconfig: son comentario. Una URL con `https://`
// pierde todo lo que va detrás de las dos barras, así que el esquema NO se
// escribe aquí — lo pone el código al construir la URL base.
TMDB_API_KEY = pon_aqui_tu_clave
TMDB_HOST = api.themoviedb.org
